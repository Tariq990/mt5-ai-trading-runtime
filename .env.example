# GPTTRADDER is hard-locked to DEMO.
GPTTRADDER_ENV=demo
GPTTRADDER_BROKER=simulated
GPTTRADDER_ALLOW_REAL_TRADING=false

# Storage / runtime
GPTTRADDER_DB_PATH=state/gpttradder.sqlite3
GPTTRADDER_RISK_TIMEZONE=Asia/Amman
# Canonical instruments. The broker adapter maps each canonical symbol to the
# actual broker symbol at runtime via mt5.symbols_get() (BTCUSDm, XAUUSD.a, ...),
# so broker-specific suffixes rarely need manual configuration.
GPTTRADDER_SYMBOLS=["BTC","ETH","XAU","EURUSD","GBPUSD"]
# Optional explicit canonical -> broker override (JSON). Needed only when several
# plausible broker symbols exist and auto-discovery reports AMBIGUOUS.
GPTTRADDER_SYMBOL_MAP={}
GPTTRADDER_CANDLE_LIMIT=120
GPTTRADDER_POLL_SECONDS=300
GPTTRADDER_EVENT_POLL_SECONDS=5
GPTTRADDER_EVENT_MOVE_BPS=20
GPTTRADDER_EVENT_SPREAD_MULTIPLIER=2.5
GPTTRADDER_EVENT_DEBOUNCE_SECONDS=30
GPTTRADDER_CYCLE_LOCK_TTL_SECONDS=240
GPTTRADDER_PACKET_MAX_AGE_SECONDS=90

# Broker clock normalization. MT5 timelines (ticks/candles/positions/deals) are
# stamped in broker SERVER time, typically UTC+2 (EET) or UTC+3 (EEST). All
# broker timestamps are shifted to UTC by this offset; quotes that are still in
# the future after normalization fail closed (TIME_INVALID / never fresh).
GPTTRADDER_BROKER_SERVER_UTC_OFFSET_HOURS=2.0
GPTTRADDER_QUOTE_FUTURE_SKEW_TOLERANCE_SECONDS=5
# Weekend session calendar for FX-style symbols (EURUSD, GBPUSD, XAU and any
# unclassified symbol): closed from Friday start hour UTC until Sunday end hour
# UTC. Algorithms (BTC/ETH) trade 24/7.
GPTTRADDER_MARKET_SESSION_WEEKEND_START_HOUR_UTC=21
GPTTRADDER_MARKET_SESSION_WEEKEND_END_HOUR_UTC=21

# Hard risk limits
GPTTRADDER_DAILY_LOSS_LIMIT_PCT=3.0
GPTTRADDER_TRAILING_DD_LIMIT_PCT=10.0

# ChatGPT decision transport
GPTTRADDER_DECISION_BRIDGE_URL=http://127.0.0.1:8787/decision
GPTTRADDER_DECISION_TIMEOUT_SECONDS=90
GPTTRADDER_DECISION_RETRY_DELAYS=[0,15,30,60]

# Existing Playwright/MCP project used by bridge/server.mjs
# REQUIRED for watchdog bridge auto-start.
GPTTRADDER_BROWSER_MCP_DIR=C:/tools/chatgpt-zcode-browser-mcp
GPTTRADDER_CHATGPT_SESSION_KEY=gpttradder
GPTTRADDER_CHATGPT_CONVERSATION_URL=https://chatgpt.com/c/YOUR-CONVERSATION-ID
# Fix 1 invariant: the INNER ChatGPT/bridge timeout must stay strictly below the
# OUTER GPTTRADDER decision timeout or cycles hang (enforced by Settings).
GPTTRADDER_CHATGPT_TIMEOUT_SECONDS=80
GPTTRADDER_BRIDGE_AUTO_START=true
# Headful browser: set false when Cloudflare's managed challenge blocks
# headless Playwright Chromium on the local machine.
GPTTRADDER_CHATGPT_HEADLESS=true

# Local dashboard (loopback only by code)
GPTTRADDER_DASHBOARD_ENABLED=true
GPTTRADDER_DASHBOARD_HOST=127.0.0.1
GPTTRADDER_DASHBOARD_PORT=8765

# Telegram alerts (optional until you add a BotFather token + target chat id)
GPTTRADDER_TELEGRAM_ENABLED=false
GPTTRADDER_TELEGRAM_BOT_TOKEN=
GPTTRADDER_TELEGRAM_CHAT_ID=
GPTTRADDER_TELEGRAM_TIMEOUT_SECONDS=10
GPTTRADDER_TELEGRAM_NOTIFY_WAIT=false
GPTTRADDER_NOTIFICATION_COOLDOWN_SECONDS=300

# Daily report
GPTTRADDER_DAILY_REPORT_ENABLED=true
GPTTRADDER_DAILY_REPORT_HOUR=23
GPTTRADDER_DAILY_REPORT_MINUTE=55

# Watchdog
GPTTRADDER_WATCHDOG_POLL_SECONDS=10
GPTTRADDER_WATCHDOG_HEARTBEAT_SECONDS=5
GPTTRADDER_WATCHDOG_STALE_SECONDS=45
GPTTRADDER_WATCHDOG_RESTART_BACKOFF_MAX_SECONDS=120
