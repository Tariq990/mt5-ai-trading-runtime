GPTTRADDER_ENV=demo
GPTTRADDER_BROKER=simulated
GPTTRADDER_DB_PATH=state/gpttradder.sqlite3
GPTTRADDER_POLL_SECONDS=300
GPTTRADDER_SYMBOLS=BTCUSD,XAUUSD
GPTTRADDER_CANDLE_LIMIT=120
